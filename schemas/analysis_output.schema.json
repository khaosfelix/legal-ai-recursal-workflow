{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisOutput",
  "type": "object",
  "required": [
    "case_id",
    "decision_label",
    "deadline_ed",
    "deadline_status",
    "material_value_used",
    "fees",
    "gross_total",
    "compensation",
    "route",
    "record_type",
    "warnings"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "decision_label": {
      "type": "string"
    },
    "deadline_ed": {
      "type": "string"
    },
    "deadline_status": {
      "type": "string"
    },
    "material_value_used": {
      "type": "number"
    },
    "fees": {
      "type": "number"
    },
    "gross_total": {
      "type": "number"
    },
    "compensation": {
      "type": "number"
    },
    "route": {
      "type": "string"
    },
    "record_type": {
      "type": "string"
    },
    "obligation": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_operational_deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}