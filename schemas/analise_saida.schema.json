{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaidaAnalise",
  "type": "object",
  "required": [
    "id_caso",
    "decisao",
    "prazo_ed",
    "transito",
    "financeiro",
    "rota",
    "posicionamento",
    "cadastro_operacional"
  ],
  "properties": {
    "id_caso": {"type": "string"},
    "decisao": {"type": "string"},
    "prazo_ed": {"type": "object"},
    "prazo_recurso_subsequente": {"type": ["object", "null"]},
    "transito": {"type": "object"},
    "financeiro": {"type": "object"},
    "rota": {"type": "string"},
    "posicionamento": {"type": "string"},
    "obrigacao_operacional": {"type": ["string", "null"]},
    "calculadora_externa": {"type": ["object", "null"]},
    "execucao": {"type": ["object", "null"]},
    "cadastro_operacional": {"type": "object"},
    "referencia_docx": {"type": ["string", "null"]},
    "proxima_providencia": {"type": ["string", "null"]},
    "prazo_operacional": {"type": ["string", "null"]},
    "alertas": {"type": "array", "items": {"type": "string"}}
  }
}
